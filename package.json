{
  "name": "dsh-lazy-ladder",
  "version": "0.1.0",
  "description": "先试最便宜的那一档：把「现成 > 已有服务 > 一条命令 > 新写」写成提示词里的梯子，并在没查就动手时补一句提醒。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "lazy",
    "reuse",
    "conciseness"
  ]
}
